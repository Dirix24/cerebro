#!/bin/sh
set -eu

raiz=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$raiz"

preparar_sistema() {
    [ -t 0 ] && command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1 || return 0
    faltantes=
    for paquete in python3-venv python3-tk poppler-utils wmctrl xdotool alsa-utils libgles2; do
        if ! dpkg-query -W -f='${db:Status-Status}' "$paquete" 2>/dev/null | tr -d '\n' | grep -qx installed; then
            faltantes="$faltantes $paquete"
        fi
    done
    [ -n "$faltantes" ] || return 0
    printf '¿Autorizar al gestor de paquetes del sistema a instalar:%s? [s/N] ' "$faltantes"
    read -r respuesta || return 0
    case "$respuesta" in
        s|S|si|sí|SI|SÍ)
            if [ "$(id -u)" -eq 0 ]; then
                apt-get install -y $faltantes || printf 'No se pudieron instalar todos los paquetes del sistema.\n'
            elif command -v sudo >/dev/null 2>&1; then
                sudo apt-get install -y $faltantes || printf 'No se pudieron instalar todos los paquetes del sistema.\n'
            else
                printf 'No hay sudo disponible para instalar los paquetes del sistema.\n'
            fi
            ;;
    esac
}

preparar_sistema
python=python3
# En una instalación nueva, el Python del sistema suele incluir el Tk de la distribución.
if [ ! -e .venv ] && ! python3 -c 'import tkinter' >/dev/null 2>&1 &&
    [ -x /usr/bin/python3 ] &&
    /usr/bin/python3 -c 'import sys, tkinter; assert sys.version_info >= (3, 10)' >/dev/null 2>&1; then
    python=/usr/bin/python3
fi
"$python" cerebro.py instalar
exec .venv/bin/python -m universe.instalar_escritorio "$@"
